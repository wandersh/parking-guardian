{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/api/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@reporters/*": ["src/reporters/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "mock-api/**/*"],
  "exclude": ["node_modules"]
}
